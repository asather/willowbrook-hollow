{
  "circle": "Acorn",
  "rules": {
    "maxSyllables": 2,
    "maxSentenceWords": 12,
    "avgSentenceWords": [
      5,
      9
    ],
    "bookWords": [
      1000,
      2000
    ],
    "chapterWords": [
      150,
      400
    ],
    "pageWords": [
      30,
      90
    ],
    "maxStoryWordsPerBook": 8,
    "outOfScope": [
      {
        "pattern": "igh",
        "label": "igh (Leaf)"
      },
      {
        "pattern": "^kn|^wr|^gn|mb$",
        "label": "silent letters kn / wr / gn / mb (Leaf)"
      },
      {
        "pattern": "ph",
        "label": "ph (Leaf)"
      },
      {
        "pattern": "tion|sion|ture",
        "label": "-tion / -sion / -ture (Leaf)"
      },
      {
        "pattern": "ough|augh|eigh",
        "label": "ough / augh / eigh (Branch)"
      },
      {
        "pattern": "ei|ie(?!s$)",
        "label": "ei / ie (Leaf)"
      },
      {
        "pattern": "c[eiy]",
        "label": "soft c (Leaf)"
      },
      {
        "pattern": "(?<![dgn])g[eiy](?!t|ft|rl|ve|ar)",
        "label": "soft g (Leaf)"
      },
      {
        "pattern": "[^aeiou]le$",
        "label": "consonant-le syllable (Leaf)"
      }
    ]
  },
