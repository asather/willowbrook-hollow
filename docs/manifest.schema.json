{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Willowbrook Manifest",
  "type": "object",
  "required": [
    "circles",
    "books"
  ],
  "additionalProperties": false,
  "properties": {
    "circles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Circles in reading order."
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "circle",
          "bookId",
          "title",
          "path",
          "circleIcon"
        ],
        "additionalProperties": false,
        "properties": {
          "circle": {
            "type": "string"
          },
          "bookId": {
            "type": "string",
            "pattern": "^[a-z]+-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "circleIcon": {
            "type": "string"
          },
          "ceremony": {
            "type": "boolean",
            "description": "true on the last book of a Circle: finishing it (and its quiz) holds the Circle Ceremony."
          }
        }
      }
    }
  }
}
