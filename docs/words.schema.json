{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Willowbrook Circle Word File",
  "type": "object",
  "required": [
    "circle",
    "rules",
    "heartWords",
    "words"
  ],
  "additionalProperties": false,
  "properties": {
    "circle": {
      "type": "string",
      "description": "Circle this file belongs to; must match the folder name."
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSyllables",
        "maxSentenceWords",
        "avgSentenceWords",
        "bookWords",
        "chapterWords",
        "pageWords",
        "maxStoryWordsPerBook",
        "outOfScope"
      ],
      "properties": {
        "maxSyllables": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Longest word allowed (names, heart words and story words are exempt). null = no limit."
        },
        "maxSentenceWords": {
          "type": "integer",
          "minimum": 1
        },
        "avgSentenceWords": {
          "$ref": "#/$defs/range"
        },
        "bookWords": {
          "$ref": "#/$defs/range"
        },
        "chapterWords": {
          "$ref": "#/$defs/range"
        },
        "pageWords": {
          "$ref": "#/$defs/range"
        },
        "maxStoryWordsPerBook": {
          "type": "integer",
          "minimum": 0
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regular expression tested against each lowercase word."
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "heartWords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "High-frequency words allowed even though they break this Circle's spelling rules. Cumulative across Circles."
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "word",
          "syllables",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "word": {
            "type": "string",
            "description": "Lowercase base form. Simple endings (-s, -es, -ed, -ing) match automatically."
          },
          "syllables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "definition": {
            "type": "string",
            "description": "One or two short sentences a child can read or hear."
          },
          "pronounce": {
            "type": "string",
            "description": "Respelling for the device voice when the spelling misleads it (e.g. vee-OH-luh)."
          },
          "audio": {
            "type": "string",
            "description": "Optional recorded pronunciation; replaces the device voice for this word."
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
